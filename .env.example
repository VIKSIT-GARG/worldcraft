# Copy to .env for backend provider configuration.
SARVAM_API_KEY=
# Gemini planning on Vertex AI.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL_ID=
# Use ADC: gcloud auth application-default login (local), or attached runtime identity.
# Optional: path to an externally managed ADC/workload identity credential file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/project/adc.json
CYBERWAVE_API_KEY=
# Existing locomotion-capable twin, e.g. a Go2 twin from your workspace catalog.
CYBERWAVE_TWIN_ID=
CYBERWAVE_ENVIRONMENT_ID=
# Miniature city mapping: city hospital (-240,0) -> Cyberwave (20,20).
# Defaults shown; X/Z city ground maps to X/Y in Cyberwave (Z is height).
CYBERWAVE_CITY_SCALE=0.05
CYBERWAVE_CITY_ORIGIN_X=20
CYBERWAVE_CITY_ORIGIN_Y=20
CYBERWAVE_ROBOT_Z=0.35
# Workshop robots use a separate staging row, clear of the existing Go2/arm.
CYBERWAVE_WORKSHOP_ORIGIN_X=20
CYBERWAVE_WORKSHOP_ORIGIN_Y=-20
# CYBERWAVE_BASE_URL=your-official-instance-url
# RUN_LIVE_INTEGRATIONS=1
# SARVAM_TEST_AUDIO=/absolute/path/to/your-voice-command.wav
